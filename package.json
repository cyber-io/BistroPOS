{
  "name": "bistro-bloom-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Bistro & Bloom restaurant POS desktop application",
  "main": "desktop/main.cjs",
  "author": "Bistro & Bloom",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "electron .",
    "build": "npm --prefix frontend run build",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:mac": "npm run build && electron-builder --mac",
    "desktop:win": "npm run build && electron-builder --win",
    "desktop:dist": "npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bistroandbloom.pos",
    "productName": "Bistro & Bloom POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icons/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "desktop/icons/icon.ico",
      "uninstallerIcon": "desktop/icons/icon.ico",
      "artifactName": "Bistro-Bloom-POS-Setup-${version}-win-${arch}.${ext}"
    },
    "artifactName": "Bistro-Bloom-POS-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Bistro-Bloom-POS-Portable-${version}-win-${arch}.${ext}"
    }
  }
}
