# Copy to env / deployment secrets manager (never commit real secrets)
ASPNETCORE_ENVIRONMENT=Production

# Database
ConnectionStrings__DefaultConnection=Host=db.example.com;Port=5432;Database=postgres;Username=app_user;Password=CHANGE_ME_STRONG_PASSWORD;SSL Mode=Require;

# Auth & Token Signing (use cryptographically random 32+ byte keys)
Jwt__SecretKey=CHANGE_ME_32_PLUS_CHAR_RANDOM_JWT_SECRET
Jwt__ExpiryMinutes=240
Security__ResourceTokenKey=CHANGE_ME_DISTINCT_32_PLUS_CHAR_RESOURCE_KEY
Security__CorsAllowedOrigins__0=https://pos.yourrestaurant.com

# Payment Gateway
PaymentGateway__Provider=Razorpay
PaymentGateway__ApiKey=CHANGE_ME_GATEWAY_KEY
PaymentGateway__SecretKey=CHANGE_ME_GATEWAY_SECRET
PaymentGateway__WebhookSecret=CHANGE_ME_WEBHOOK_SECRET

# Supabase Auth (optional)
Supabase__Url=https://your-project.supabase.co
Supabase__AnonKey=CHANGE_ME_ANON_KEY
Supabase__ServiceRoleKey=CHANGE_ME_SERVICE_ROLE_KEY

# Feature Flags (keep false outside local dev)
Features__EnableDemoLogin=false
