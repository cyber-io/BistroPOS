# API requests use the Vite /api proxy in development.
# For a separately hosted website, set the deployed .NET API base URL.
# VITE_API_URL=https://api.yourrestaurant.com/api
VITE_RESTAURANT_ID=a0000000-0000-0000-0000-000000000001
# Public URL printed on table QR codes. Use your deployed website origin.
# VITE_PUBLIC_SITE_URL=https://yourrestaurant.com
# Optional Supabase Auth password-reset configuration (public anon key only).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
